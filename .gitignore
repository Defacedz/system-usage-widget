# Build output (the installer compiles into %TEMP%, but just in case)
*.exe
*.dll
*.pdb
bin/
obj/

# Signing material - must never be committed
*.cer
*.pfx
*.snk

# Local runtime state
log.txt
config.json
tokens.json
*.credentials.json

# The embedded sensor library (MIT) and the assemblies it loads at runtime
# are the project's shipped binaries; everything else builds from source.
!lib/LibreHardwareMonitorLib.dll
!lib/HidSharp.dll
!lib/System.Memory.dll
!lib/System.Runtime.CompilerServices.Unsafe.dll
!lib/System.Buffers.dll
!lib/RAMSPDToolkit-NDD.dll
!lib/DiskInfoToolkit.dll
!lib/BlackSharp.Core.dll
